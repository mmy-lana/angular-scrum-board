# Shell title shown in the document and app header.
VITE_APP_TITLE=Angular Scrum Board

# IndexedDB database name backing the local-first storage client.
# Defaults to "ScrumBoardDatabase" when unset.
VITE_DB_NAME=ScrumBoardDatabase

# Project the board opens on at first boot.
# Defaults to "project-scrum-default" when unset.
VITE_DEFAULT_PROJECT_ID=project-scrum-default
